# Required for live voice
OPENAI_API_KEY=

# Required for current-news research
EXA_API_KEY=

# Dormant legacy Sponge adapter; the voice agent uses AgentCash by default.
SPONGE_API_KEY=

# Optional: expands paid endpoint discovery. AgentCash still makes and pays requests.
ORTHOGONAL_API_KEY=

# Coinbase for Agents CLI. These credentials are required for balances and orders.
COINBASE_ENV=live
COINBASE_KEY_ID=
COINBASE_KEY_SECRET=

# Optional
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
OPENAI_SUMMARY_MODEL=gpt-5.6-luna
DEFAULT_PRODUCT=HYPE-USD
PORT=4173

# Nansen smart-money tool: use either an API key or a funded x402 wallet created by nansen-cli.
NANSEN_API_KEY=
NANSEN_WALLET_PASSWORD=
NANSEN_X402_EVM_ADDRESS=

# ── Hosted web + phone capability (Fly + Vapi). Off by default for local dev. ──
# Enables the /dashboard viewer and /vapi/webhook endpoint. Leave blank locally.
ENABLE_WEB_PHONE=
# Public URL of the deployed app, used when configuring the Vapi assistant.
PUBLIC_BASE_URL=
# Password for the private web dashboard login.
DASHBOARD_PASSWORD=
# Signs the dashboard session cookie (random 32+ byte hex).
SESSION_SECRET=
# Vapi: bring-your-own-agent (OpenAI Realtime speech-to-speech) — inbound phone.
VAPI_PRIVATE_KEY=
VAPI_PUBLIC_KEY=
VAPI_AGENT_ID=
VAPI_PHONE_NUMBER=
# Shared secret Vapi sends as x-vapi-secret; verifies /vapi/webhook requests.
VAPI_WEBHOOK_SECRET=
# Only this caller ID is allowed to reach the phone agent (inbound allowlist).
PHONE_NUMBER=
# ── Phone via OpenAI SIP (Telnyx → OpenAI directly; gpt-live-1 / gpt-realtime-2.1). ──
# Enables /openai/incoming-call and /telnyx/texml. Requires ENABLE_WEB_PHONE too.
ENABLE_OPENAI_SIP=
# OpenAI project id (Settings → Project → General), used in the SIP URI.
OPENAI_PROJECT_ID=
# Signing secret of the OpenAI webhook endpoint (realtime.call.incoming + live.transport.incoming).
OPENAI_WEBHOOK_SECRET=
# The Telnyx number that reaches the OpenAI agents (E.164).
SIP_PHONE_NUMBER=
# Which OpenAI agent answers by default: gpt-live-1 | gpt-realtime-2.1 (dashboard dropdown overrides, persisted).
OPENAI_SIP_AGENT=gpt-live-1
# Realtime-path model and gpt-live-1 delegation backend.
OPENAI_SIP_MODEL=gpt-realtime-2.1
OPENAI_LIVE_BACKEND_MODEL=gpt-5.6-luna
OPENAI_LIVE_REASONING_EFFORT=low
# ── Outbound pitch calls ("Jordan"): the agent calls YOU with a trade idea. ──
# Requires ENABLE_WEB_PHONE too. See docs/specs/wolf-pitch-calls.md.
ENABLE_PITCH_CALLS=
# Read-only (SELECT-only) connection string to the desk's Neon DB, the idea source.
DESK_DATABASE_URL=
# Written by scripts/configure-vapi-pitch.mjs.
VAPI_PITCH_ASSISTANT_ID=
# A Telnyx number imported into Vapi (free Vapi numbers cannot dial out): Vapi id + E.164.
VAPI_PITCH_PHONE_NUMBER_ID=
PITCH_PHONE_NUMBER=
# Who gets called (defaults to the first PHONE_NUMBER entry).
PITCH_CALL_TO=
# ElevenLabs secret key (sk_...), used for the pre-call credit check. Also add it in Vapi → Integrations.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=Ifu36BnEjjIY932etsqk
# Built-in Vapi voice used when ElevenLabs is out of credit or fails mid-call.
PITCH_FALLBACK_VOICE=Godfrey
# Hard cap (USD notional incl. fees) on any order placed during a pitch call.
PITCH_MAX_ORDER_USD=500
PITCH_MAX_CALLS_PER_DAY=3
PITCH_MIN_SPACING_MIN=60
PITCH_MIN_CONVICTION=7
PITCH_MAX_IDEA_AGE_HOURS=6
PITCH_MIN_REWARD_RISK=1.5
PITCH_SCAN_INTERVAL_MIN=10
# LLM that drives the Vapi pitch conversation (must be on Vapi's OpenAI model list).
PITCH_LLM_MODEL=gpt-4.1
# Which Jordan calls by default (dashboard switch overrides): elevenlabs (Vapi) | realtime (gpt-realtime-2.1).
PITCH_ENGINE=elevenlabs
# gpt-realtime-2.1 engine: a Telnyx Call Control app (webhook /telnyx/pitch-events) on an outbound profile.
# Also needs ENABLE_OPENAI_SIP, OPENAI_PROJECT_ID, OPENAI_WEBHOOK_SECRET.
TELNYX_API_KEY=
TELNYX_PITCH_CONNECTION_ID=
PITCH_REALTIME_VOICE=cedar
# 1 = run the whole pipeline but print the brief instead of dialing.
PITCH_DRY_RUN=
# Fly.io deploy token (used by flyctl / CI; not read by the app).
FLY_API_KEY=
