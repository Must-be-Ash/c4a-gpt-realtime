{
  "name": "c4a-gpt-realtime",
  "version": "0.1.0",
  "description": "A voice-first crypto research and Coinbase trading prototype built with OpenAI Realtime.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Must-be-Ash/c4a-gpt-realtime.git"
  },
  "bugs": {
    "url": "https://github.com/Must-be-Ash/c4a-gpt-realtime/issues"
  },
  "homepage": "https://coinbase-for-agents.vercel.app",
  "type": "module",
  "scripts": {
    "build": "node scripts/sync-skill.mjs && esbuild public/app.js --bundle --format=esm --outfile=public/app.bundle.js",
    "dev": "npm run build && node --watch src/server.js",
    "start": "npm run build && node src/server.js",
    "test": "node --test",
    "check": "npm run build && node --check src/server.js && node --check public/app.js && node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@openai/agents": "^0.16.1",
    "agentcash": "^0.17.1",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
